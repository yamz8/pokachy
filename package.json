{
  "name": "pokachy",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server",
    "types": "npm run types --workspace server",
    "check": "npm run check --workspace server",
    "test": "npm run test --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "build:cli": "cd cli && go build -o bin/pokachy ./cmd/pokachy",
    "test:cli": "cd cli && go test ./...",
    "verify": "python3 scripts/verify.py",
    "verify:e2e": "python3 scripts/verify-e2e.py",
    "verify:install": "python3 scripts/verify-install.py",
    "verify:live": "python3 scripts/verify-live.py"
  }
}
